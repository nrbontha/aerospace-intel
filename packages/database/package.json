{
  "name": "@asi/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit false --declaration --declarationMap --sourceMap",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@asi/contracts": "*",
    "drizzle-orm": "0.45.2",
    "pg": "8.16.3",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.8",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
