# Runtime
# NODE_ENV is required at process start. This example value is for local use.
# Railway must set NODE_ENV=production. Unset NODE_ENV fails startup.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL
POSTGRES_DB=aerospace_supplier_intelligence
POSTGRES_USER=asi
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://asi:local-development-only@database:5432/aerospace_supplier_intelligence
WEB_PORT=3000

# Authentication and one-time admin bootstrap
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=asi_session
SESSION_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password

# OpenRouter model routing and cost limits
OPENROUTER_API_KEY=
# Optional Exa search
EXA_API_KEY=
# Optional SAM.gov Entity Management API
SAM_API_KEY=
# Optional targeted FAA DRS guest-browser PMA source
FAA_DRS_BROWSER_ENABLED=false
FAA_DRS_CHROMIUM_PATH=
OPENROUTER_MODEL_FAST=openai/gpt-5.4-mini
OPENROUTER_MODEL_DEEP=anthropic/claude-sonnet-5
OPENROUTER_MODEL_FALLBACK=google/gemini-3.7-flash
OPENROUTER_MAX_COST_PER_RUN_USD=2.00
OPENROUTER_MAX_COST_PER_DAY_USD=15.00

# Automatic investor review: evidence -> Jev ladder -> same-input Muse
# These conservative values are examples, not the authorized production backfill.
FAA_JEV_MODEL=typesafe/jev-1.13
FAA_MODEL_A=meta/muse-spark-1.3-contributor
JEV_AUDIT_SAMPLE_RATE=0.05
EXA_DAILY_BUDGET_USD=2
# Set EXA_SPEND_STATE_PATH to a worker-persistent file in production.
SIGNAL_EVIDENCE_LIMIT=6
SIGNAL_EVIDENCE_CONCURRENCY=3
ENSEMBLE_BATCH_LIMIT=12
JEV_LADDER_CONCURRENCY=4
VERIFY_BATCH_LIMIT=12
ENSEMBLE_CONCURRENCY=3
ENSEMBLE_DELAY_MS=500
JEV_FAST_INTERVAL_MS=5000
ENSEMBLE_SCHEDULE_MINUTES=5

# Bounded research execution
RESEARCH_QUEUE_NAME=research-jobs
RESEARCH_MAX_TOOL_CALLS=50
RESEARCH_CONCURRENCY=5

# Durable document storage
STORAGE_PATH=./storage
# Research document writes require RESEARCH_SHARED_STORAGE=true.
# NODE_ENV=development|test does not open writes.
# Local Compose shares uploaded-storage; set true in gitignored .env.local.
# Railway volumes are per-service and do not replicate. A worker volume is
# not shared storage. Keep this unset/false in production until web and
# worker share one object store. Per-service volumes must not set this true.
RESEARCH_SHARED_STORAGE=

# Worker health server uses PORT. When web already binds 3000, set worker PORT=3001.
# STORAGE_PATH must be a persistent volume in production.
